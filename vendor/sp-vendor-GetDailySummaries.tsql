SET ANSI_NULLS ON;
SET QUOTED_IDENTIFIER ON;

USE	SabaDB;
GO
DECLARE	@Object		SYSNAME
	,	@Version	SYSNAME		= N'0.1.0'
;

SELECT @Object		= N'vendor.GetDailySummaries'
EXECUTE	dbo.sp_MSR_InitProcedure @Object;
EXECUTE	dbo.sp_MSR_SetVersion @Object, @Version;
GO
ALTER PROCEDURE	vendor.GetDailySummaries
	@Vendor		TINYINT
,	@ReportDate	DATE
-- WITH ENCRYPTION
AS
BEGIN;
	SET NOCOUNT ON;

	DECLARE	@Query	NVARCHAR(MAX)	= N''
		,	@ToTime	DATE			= DATEADD(DAY, 1, @ReportDate)
		;

	SELECT	@Query = CONCAT(@Query, N'\
SELECT	t.operatorId
	,	t.siteId
	,	t.time AS reportDate
	,	t.gameId
	,	g.gameTypeId
	,	g.gameName
	,	t.currency
	,	t.tickets
	,	t.stake
	,	t.payout 
	,	t.winloss
	,	t.refund
	,	t.usdStake
	,	t.usdPayout 
	,	t.usdWinloss
	,	t.usdRefund
FROM		summary.daily_summaries AS t
INNER JOIN	summary.game_summary_config AS g
		ON	t.gameId = g.gameId
WHERE	t.time >= "', FORMAT(@ReportDate, 'yyyy-MM-ddTHH:mm:ssZ'), N'"
	AND	t.time < "', FORMAT(@ToTime, 'yyyy-MM-ddTHH:mm:ssZ'), N'"
	AND	t.currency <> "UUS"
	AND	t.operatorId <> "SabaPlay"
');

	EXECUTE vendor.Query @Query = @Query, @Vendor = @Vendor;
END;
GO
BEGIN TRY;
	IF	TYPE_ID('vendor.DailySummaries') IS NOT NULL
		DROP TYPE vendor.DailySummaries;

	CREATE TYPE	vendor.DailySummaries AS TABLE (
		operatorId		NVARCHAR(128)
	,	siteId			NVARCHAR(128)
	,	reportDate		DATE
	,	gameId			INT
	,	gameTypeId		INT
	,	gameName		NVARCHAR(128)
	,	currency		VARCHAR(16)
	,	tickets			BIGINT
	,	stake			DECIMAL(19,4)
	,	payout			DECIMAL(19,4)
	,	winloss			DECIMAL(19,4)
	,	refund			DECIMAL(19,4)
	,	usdStake		DECIMAL(19,4)
	,	usdPayout		DECIMAL(19,4)
	,	usdWinloss		DECIMAL(19,4)
	,	usdRefund		DECIMAL(19,4)
	,	PRIMARY KEY NONCLUSTERED (operatorId, siteId, reportDate, gameId, currency)
	) WITH (MEMORY_OPTIMIZED = ON);
END TRY BEGIN CATCH;
	EXECUTE	logger.Error N'Type'
END CATCH;
GO
