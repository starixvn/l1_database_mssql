CREATE ROLE svc_exchange AUTHORIZATION dbo;
GO
GRANT SELECT, INSERT, DELETE, UPDATE, VIEW DEFINITION, REFERENCES, EXECUTE ON SCHEMA::dbr TO svc_exchange;
GRANT SELECT, INSERT, DELETE, UPDATE, VIEW DEFINITION, REFERENCES, EXECUTE ON SCHEMA::l1 TO svc_exchange;
GRANT SELECT, INSERT, DELETE, UPDATE, VIEW DEFINITION, REFERENCES, EXECUTE ON SCHEMA::l2 TO svc_exchange;
GRANT SELECT, INSERT, DELETE, UPDATE, VIEW DEFINITION, REFERENCES, EXECUTE ON SCHEMA::l4 TO svc_exchange;
GRANT SELECT, INSERT, DELETE, UPDATE, VIEW DEFINITION, REFERENCES, EXECUTE ON SCHEMA::l5 TO svc_exchange;
GO