SET ANSI_NULLS ON;
SET QUOTED_IDENTIFIER ON;

USE	SabaDB;
GO
DECLARE	@Object		SYSNAME
	,	@Version	SYSNAME		= N'0.1.1'
;

SELECT @Object		= N'sg.DailySummaryReport'
EXECUTE	dbo.sp_MSR_InitProcedure @Object;
EXECUTE	dbo.sp_MSR_SetVersion @Object, @Version;
GO
ALTER PROCEDURE	sg.DailySummaryReport
	@ReportDate	DATE
,	@isTest		BIT		= 1
-- WITH ENCRYPTION
AS
BEGIN;
	SET NOCOUNT ON;

	DECLARE	@VendorId		TINYINT = 42
		,	@Mismatch		TINYINT
		,	@Message		NVARCHAR(MAX)	= N''
		,	@NL				NVARCHAR(10)	= NCHAR(13) + NCHAR(10)
		,	@Target			NVARCHAR(128)	= IIF(@isTest = 0, N'Daily', N'Billy')
	;

	-- EXECUTE	@Mismatch = dbr.DailySummaryMismatch @VendorId, @ReportDate, @isTest;

	DECLARE	@VendorDailySum		vendor.DailySummaries;
	INSERT INTO	@VendorDailySum
	EXECUTE	vendor.GetDailySummaries @VendorId, @ReportDate;

	SELECT	@Message = N''
		,	@Message = CONCAT(
				@Message
			,	dbo.f_escMDv2(CONCAT(N'[', IIF(@Mismatch > 0, N'MISMATCH', N'OK'), N']  [ SABA·games Summary ]'))
			,	N'  `', dbo.f_escMDv2(FORMAT(@ReportDate, 'yyyy-MM-dd')), N'`'
			,	@NL, @NL
			,	STRING_AGG(o.str, @NL)
			)
	FROM	(
		SELECT	[str] = CONCAT_WS(@NL
				,	CONCAT(N'`', dbo.f_escMDv2(operatorId), N'`:')
				,	CONCAT(N'    \- *BC*:   `', dbo.f_escMDv2(FORMAT(SUM(tickets), '#,##0')), N'`')
				,	CONCAT(N'    \- *TO*:   `', dbo.f_escMDv2(FORMAT(SUM(usdStake), '#,##0.##')), N'`')
				,	CONCAT(N'    \- *WL*:   `', dbo.f_escMDv2(FORMAT(SUM(usdWinloss), '#,##0.##')), N'`')
				,	N'')
		FROM	@VendorDailySum
		GROUP BY operatorId
	) AS o;

	EXECUTE	NOTI.NotificationDB.dbo.SendNotification @Target, @Message;

	SELECT	@Message = N''
		,	@Message = CONCAT(
				@Message
			-- ,	CONCAT(N'[', IIF(@Mismatch > 0, N'MISMATCH', N'OK'), N']  [ SABA·games Summary ]')
			,	N'[ SABA·games Summary ]'
			,	N'  ', FORMAT(@ReportDate, 'yyyy-MM-dd')
			,	@NL, @NL
			,	STRING_AGG(o.str, @NL)
			)
	FROM	(
		SELECT	[str] = CONCAT_WS(@NL
				,	CONCAT(N'**', operatorId, N'**:')
				,	CONCAT(N'> **BC**:   ', FORMAT(SUM(tickets), '#,##0'))
				,	CONCAT(N'> **TO**:   ', FORMAT(SUM(usdStake), '#,##0.##'))
				,	CONCAT(N'> **WL**:   ', FORMAT(SUM(usdWinloss), '#,##0.##'))
				,	N'')
		FROM	@VendorDailySum
		GROUP BY operatorId
	) AS o;

	IF @isTest = 0
	BEGIN;
		EXECUTE	DBNOTI.NotificationDB.dbo.Skype_SendMessage 'S-LUMI-DAILY', @Message;
	END;
	ELSE
	BEGIN;
		EXECUTE	DBNOTI.NotificationDB.dbo.Skype_SendMessage 'TL-RISK', @Message;
	END;
END;
GO
DECLARE	@reportDate	DATE = CAST(GETUTCDATE() AS DATE);
EXECUTE	sg.DailySummaryReport @reportDate;