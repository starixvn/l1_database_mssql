SET ANSI_NULLS ON;
SET QUOTED_IDENTIFIER ON;

USE	SabaDB;
GO
DECLARE	@Object		SYSNAME
	,	@Version	SYSNAME		= N'0.1.2'
;
SELECT @Object		= N'dbr.DailySummaryMismatch'
EXECUTE	dbo.sp_MSR_InitProcedure @Object;
EXECUTE	dbo.sp_MSR_SetVersion @Object, @Version;
GO
ALTER PROCEDURE	dbr.DailySummaryMismatch
	@vendorId		TINYINT
,	@reportDate		DATE
,	@isTest			BIT		= 1
-- WITH ENCRYPTION
AS
BEGIN;
	SET NOCOUNT ON;

	DECLARE	@VendorDailySum		vendor.DailySummaries;
	DECLARE	@OperatorDailySum	operator.DailySummaries;
	DECLARE	@Mismatches			operator.DailySummaries;

	INSERT INTO	@VendorDailySum
	EXECUTE	vendor.GetDailySummaries @vendorId, @reportDate;

	INSERT INTO @OperatorDailySum
	EXECUTE	operator.GetDailySummaries @vendorId, @reportDate;

	INSERT INTO	@Mismatches (siteId, reportDate, gameTypeId, gameName, currency, tickets, stake, payout)
	SELECT	[operatorId]	= ISNULL(m.operatorId, v.operatorId)
		,	[reportDate]	= ISNULL(o.reportDate, v.reportDate)
		,	[gameTypeId]	= ISNULL(o.gameTypeId, v.gameTypeId)
		,	[gameName]		= ISNULL(o.gameName, v.gameName)
		,	[currency]		= ISNULL(o.currency, v.currency)
		,	[tickets]		= diff.tickets
		,	[stake]			= diff.stake
		,	[payout]		= diff.payout
	FROM			@OperatorDailySum AS o
	OUTER APPLY		dbr.tf_OW_OperatorMapping(@vendorId, NULLIF(o.siteId, N'-')) AS m
	FULL OUTER JOIN	@VendorDailySum AS v
				ON	v.reportDate = o.reportDate
				AND	m.operatorId = v.operatorId
				AND	o.currency = v.currency
				AND	o.gameTypeId = v.gameTypeId
	CROSS APPLY	(VALUES	(
		ISNULL(o.tickets, 0) - ISNULL(v.tickets, 0)
	,	ISNULL(o.stake  , 0) - ISNULL(v.stake  , 0)
	,	ISNULL(o.payout , 0) - ISNULL(v.payout , 0)
	)) AS diff(tickets, stake, payout)
	LEFT JOIN	dbr.tf_JackpotBettype() AS jp
			ON	o.gameTypeId = jp.gameTypeId
	WHERE	diff.tickets + diff.stake + diff.payout <> 0
		AND	jp.gameTypeId IS NULL;

	IF	EXISTS(SELECT 1 FROM @Mismatches)
	BEGIN;
		DECLARE	@NL			NVARCHAR(10)	= NCHAR(13) + NCHAR(10)
			,	@Message	NVARCHAR(MAX)
			,	@Target		NVARCHAR(128)	= IIF(@isTest = 1, N'Billy', N'Daily')
			;

		SELECT	@Message = CONCAT(
					N'\[ *MISMATCH* \]'
				,	dbo.f_escMDv2(CONCAT(
						N' ['
					,	CASE @vendorId
							WHEN 42 THEN N'SG'
							WHEN 66 THEN N'VG'
							WHEN 86 THEN N'XD'
							WHEN 102 THEN N'SK'
							ELSE N'??'
						END
					,	N'] @ ', FORMAT(@reportDate, 'yyyy-MM-dd'), @NL
					))
				,	STRING_AGG(od.str, @NL)
				)
		FROM	(
			SELECT	DISTINCT siteId
			FROM	@Mismatches
		) AS o
		CROSS APPLY	(
			SELECT	[str] = CONCAT(
						N'**>`', dbo.f_escMDv2(o.siteId), N'`'
					,	dbo.f_escMDv2(N': ( BC | TO | PO )  ')
					,	@NL
					,	STRING_AGG(gd.str, @NL)
					,	@NL, N'>||'
					)
			FROM	(
				SELECT	DISTINCT gameTypeId
				FROM	@Mismatches AS _m
				WHERE	_m.siteId = o.siteId
			) AS g
			CROSS APPLY	(
				SELECT	[str] = CONCAT(
							N'>    '
						,	dbo.f_escMDv2(CONCAT(
								N'[', __m.gameTypeId, N'] ', MAX(__m.gameName), N':  '
							,	FORMAT(SUM(__m.tickets), '#,##0'), N' | '
							,	FORMAT(SUM(__m.stake), '#,##0.##'), N' | '
							,	FORMAT(SUM(__m.payout), '#,##0.##')
							))
						)
				FROM	@Mismatches AS __m
				WHERE	__m.siteId = o.siteId
					AND	__m.gameTypeId = g.gameTypeId
				GROUP BY __m.siteId, __m.gameTypeId
			) AS gd
		) AS od;

		EXECUTE	NOTI.NotificationDB.dbo.SendNotification @Target, @Message;

		SELECT	@Message = N''
			,	@Message = CONCAT(
					N'[ **MISMATCH** ]'
				,	CONCAT(
						N' ['
					,	CASE @vendorId
							WHEN 42 THEN N'SG'
							WHEN 66 THEN N'VG'
							WHEN 86 THEN N'XD'
							WHEN 102 THEN N'SK'
							ELSE N'??'
						END
					,	N'] @ ', FORMAT(@reportDate, 'yyyy-MM-dd'), @NL
					)
				,	STRING_AGG(od.str, @NL)
				)
		FROM	(
			SELECT	DISTINCT siteId
			FROM	@Mismatches
		) AS o
		CROSS APPLY	(
			SELECT	[str] = CONCAT(
						N'**', o.siteId, N'**'
					,	N': ( BC | TO | PO )  '
					,	@NL
					,	STRING_AGG(gd.str, @NL)
					)
			FROM	(
				SELECT	DISTINCT gameTypeId
				FROM	@Mismatches AS _m
				WHERE	_m.siteId = o.siteId
			) AS g
			CROSS APPLY	(
				SELECT	[str] = CONCAT(
							N'>'
						,	CONCAT(
								N'[', __m.gameTypeId, N'] ', MAX(__m.gameName), N':  '
							,	FORMAT(SUM(__m.tickets), '#,##0'), N' | '
							,	FORMAT(SUM(__m.stake), '#,##0.##'), N' | '
							,	FORMAT(SUM(__m.payout), '#,##0.##')
							)
						)
				FROM	@Mismatches AS __m
				WHERE	__m.siteId = o.siteId
					AND	__m.gameTypeId = g.gameTypeId
				GROUP BY __m.siteId, __m.gameTypeId
			) AS gd
		) AS od;

		IF @isTest = 0
		BEGIN;
			EXECUTE	DBNOTI.NotificationDB.dbo.Skype_SendMessage 'S-LUMI-DAILY', @Message;
		END;
		ELSE
		BEGIN;
			EXECUTE	DBNOTI.NotificationDB.dbo.Skype_SendMessage 'TL-RISK', @Message;
		END;

		RETURN 1;
	END;

	RETURN 0;
END;
GO
DECLARE	@reportDate	DATE = CAST(GETUTCDATE() AS DATE);

EXECUTE	dbr.DailySummaryMismatch 42, @reportDate;
EXECUTE	dbr.DailySummaryMismatch 66, @reportDate;
EXECUTE	dbr.DailySummaryMismatch 86, @reportDate;
EXECUTE	dbr.DailySummaryMismatch 102, @reportDate;
